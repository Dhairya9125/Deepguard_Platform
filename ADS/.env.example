# ADS Environment Configuration
# Copy to .env and modify for your environment

# Application
ADS_ENVIRONMENT=development
ADS_DEBUG=true
ADS_LOG_LEVEL=INFO
ADS_LOG_FORMAT=json
ADS_DATA_DIR=./data
ADS_MODEL_DIR=./models

# Audio Configuration
ADS_AUDIO__SAMPLE_RATE=16000
ADS_AUDIO__CHUNK_DURATION_SECONDS=5.0
ADS_AUDIO__MAX_DURATION_SECONDS=30.0

# VAD
ADS_VAD__THRESHOLD=0.5

# Diarization
ADS_DIARIZATION__MODEL_ID=pyannote/speaker-diarization-3.1

# Models
ADS_MODEL_BACKEND=cpu

# Database
ADS_DATABASE__URL=postgresql+asyncpg://ads:ads@localhost:5432/ads

# Redis
ADS_REDIS__URL=redis://localhost:6379/0

# Kafka
ADS_KAFKA__BOOTSTRAP_SERVERS=localhost:9092

# MLflow
ADS_MLFLOW__TRACKING_URI=http://localhost:5000

# Security
ADS_SECURITY__SECRET_KEY=change-this-in-production-use-a-256-bit-key
ADS_SECURITY__RATE_LIMIT_PER_MINUTE=60
ADS_SECURITY__MAX_UPLOAD_SIZE_MB=100
